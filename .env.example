# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: third-party TTS providers used by the "TTS provider" tabs in the
# AI result card preview. If a key is not set here, the UI lets the user paste
# one (stored in localStorage, sent as the `x-tts-key` request header).
DEEPGRAM_API_KEY="sk_..."
CARTESIA_API_KEY="sk_car_..."
FISH_AUDIO_API_KEY="..."
